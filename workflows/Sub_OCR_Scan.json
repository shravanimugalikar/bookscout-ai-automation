    {
      "parameters": {
        "jsCode": "const search = $('Open Library Search').first().json.docs[0];\nconst llm = $('Identify Book from OCR Text').first().json.output;\n\nconst title = llm.title || search.title || \"Unknown\";\nconst author = llm.author || search.author_name?.join(\", \") || \"Unknown\";\nconst summary = llm.summary || \"No summary available.\";\n\nreturn [{\n  json: {\n    chat_id: $('Extract Largest Photo').first().json.chat_id,\n    message:\n`📸 <b>Book Identified!</b>\n\n📚 <b>${title}</b>\n\n✍ <b>Author:</b> ${author}\n\n📅 <b>First Published:</b> ${search.first_publish_year || \"Unknown\"}\n\n📖 <b>Summary:</b>\n${summary}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2288,
        256
      ],
      "id": "799087da-cdb1-49ad-861c-f63fb5c7925e",
      "name": "Format OCR Book Response"
