    {
      "parameters": {
        "jsCode": "const parsed = $json.ParsedResults?.[0];\n\nreturn [{\n  json: {\n    chat_id: $('Extract Largest Photo').first().json.chat_id,\n    ocr_text: parsed?.ParsedText || \"\"\n  }\n}];"
