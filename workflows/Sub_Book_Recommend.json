        "jsCode": "const text = $json.text || \"\";\nconst chatId = String($json.chatId || \"\");\n\nreturn [\n  {\n    json: {\n      chat_id: chatId,\n      query: text.replace(/^\\/recommend\\s*/i, \"\").trim()\n    }\n  }\n];"
