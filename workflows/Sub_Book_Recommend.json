    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"recommendations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"author\": {\n            \"type\": \"string\"\n          },\n          \"reason\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"title\",\n          \"author\",\n          \"reason\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"recommendations\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        896,
        560
      ],
      "id": "17584b3f-ba4f-487d-99ea-008c330f9901",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// LLM output is inside data.output\nconst recommendations = data.output?.recommendations || [];\n\n// Get Telegram chat ID from the original query node\nconst chatId = $('Extract Recommendation Query').first().json.chat_id;\n\nif (!Array.isArray(recommendations) || recommendations.length === 0) {\n  return [\n    {\n      json: {\n        chat_id: chatId,\n        text: \"Sorry, I couldn't find any book recommendations.\"\n      }\n    }\n  ];\n}\n\nlet text = \"📚 <b>Book Recommendations</b>\\n\\n\";\n\nrecommendations.forEach((book, index) => {\n  text += `${index + 1}. <b>${book.title || \"Unknown Title\"}</b>\\n`;\n  text += `✍️ <b>Author:</b> ${book.author || \"Unknown\"}\\n`;\n  text += `💡 ${book.reason || \"Recommended based on your request.\"}\\n\\n`;\n});\n\nreturn [\n  {\n    json: {\n      chat_id: chatId,\n      text: text.trim()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        352
      ],
      "id": "0e29263a-62cb-4db4-b117-645371dbfec4",
      "name": "Format Recommendations"
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "c055762a-8fe7-4141-a639-df2372f30060",
      "typeVersion": 1.1,
      "name": "Receive Recommendation Request",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "position": [
        272,
        352
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Recommend books for:\n\n{{ $json.query }}",
        "hasOutputParser": true,
        "needsFallback": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are BookScout, an AI book recommendation assistant.\n\nYour task is to recommend books based on the user's request.\n\nThe user's request may be written in English, Marathi, Hindi, or a combination of languages.\n\nIMPORTANT INSTRUCTIONS:\n\n1. Understand the meaning of the user's request regardless of the language.\n2. If the user asks for \"Marathi books\", recommend books written in Marathi.\n3. If the user asks for \"Hindi books\", recommend books written in Hindi.\n4. If the user asks for books in English, recommend English books.\n5. If the user specifies a genre, topic, author, country, period, or subject, follow that requirement.\n6. Recommend 3 to 5 books.\n7. Do not invent book titles or authors.\n8. The \"title\", \"author\", and \"reason\" values may be written in the appropriate language.\n9. Keep the reason short and concise.\n10. DO NOT translate or rename the JSON field names.\n11. The JSON field names MUST remain exactly:\n    - recommendations\n    - title\n    - author\n    - reason\n12. Do not add any additional fields.\n13. Do not return Markdown.\n14. Do not wrap the response in ```json.\n15. Return only the structured output required by the output parser.\n\nUser request:\n\n{{ $json.query }}"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
