{
  "name": "BookScout_Global_Error_Handler",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const execution = $json.execution || {};\nconst workflow = $json.workflow || {};\nconst error = execution.error || {};\n\nreturn [\n  {\n    json: {\n      workflow_name: workflow.name || \"Unknown Workflow\",\n      execution_id: execution.id || \"Unknown\",\n      error_node: execution.lastNodeExecuted || \"Unknown Node\",\n      error_message:\n        error.description ||\n        error.message ||\n        \"Unknown Error\",\n      error_details: error\n    }\n  }\n];"
      },
