    {
      "parameters": {
        "jsCode": "const text = $json.message.text;\n\nreturn [{\n  json: {\n    chat_id: $json.message.chat.id,\n    query: text.replace(\"/search\", \"\").trim()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        352
      ],
      "id": "231d5640-90bd-473a-a018-e66f60a0f434",
      "name": "Extract Search Query"
    },
    {
      "parameters": {
        "jsCode": "// Search response\nconst search = $('Open Library Search').first().json.docs[0];\n// Work details response\nconst details = $('Get Book Details').first().json;\n\n// Function to clean descriptions\nfunction sanitizeDescription(text) {\n  if (!text) return \"No description available.\";\n  return text\n    // Remove Markdown links [text](url)\n    .replace(/\\[.*?\\]\\(.*?\\)/g, '')\n    // Remove raw URLs\n    .replace(/https?:\\/\\/\\S+/g, '')\n    // Collapse multiple spaces/newlines\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\n// Function to fix ALL-CAPS \"shouting\" words from jacket-copy formatting\nfunction normalizeShouting(text) {\n  return text.replace(/\\b[A-Z]{2,}\\b/g, (word) => {\n    // Keep short real acronyms (2-3 letters) as-is, title-case the rest\n    if (word.length <= 3) return word;\n    return word.charAt(0) + word.slice(1).toLowerCase();\n  });\n}\n\n// Get description\nlet description = \"No description available.\";\nif (details.description) {\n  if (typeof details.description === \"string\") {\n    description = details.description;\n  }\n  else if (details.description.value) {\n    description = details.description.value;\n  }\n} else if (details.subjects) {\n  description = details.subjects\n    .slice(0, 5)\n    .join(\", \");\n}\n\n// Clean and normalize description\ndescription = normalizeShouting(sanitizeDescription(description));\n\n// Truncate long descriptions, preferring a sentence boundary\nconst MAX_LENGTH = 500;\nif (description.length > MAX_LENGTH) {\n  const truncated = description.substring(0, MAX_LENGTH);\n  const lastSentenceEnd = Math.max(\n    truncated.lastIndexOf(\". \"),\n    truncated.lastIndexOf(\"! \"),\n    truncated.lastIndexOf(\"? \")\n  );\n  if (lastSentenceEnd > MAX_LENGTH * 0.5) {\n    // Only use the sentence boundary if it's not too far back\n    description = truncated.substring(0, lastSentenceEnd + 1);\n  } else {\n    const lastSpace = truncated.lastIndexOf(\" \");\n    description = truncated.substring(0, lastSpace > 0 ? lastSpace : MAX_LENGTH) + \"...\";\n  }\n}\n\nreturn [{\n  json: {\n    chat_id: $('Receive Book Search Request')\n      .first()\n      .json\n      .message\n      .chat\n      .id,\n    title: search.title || \"Unknown\",\n    author: search.author_name\n      ? search.author_name.join(\", \")\n      : \"Unknown\",\n    year: search.first_publish_year || \"Unknown\",\n    cover: search.cover_i\n      ? `https://covers.openlibrary.org/b/id/${search.cover_i}-L.jpg`\n      : \"\",\n    description\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
